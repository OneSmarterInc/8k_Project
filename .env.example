# Copy this file to .env and fill in real values.
# .env must NOT be committed to source control.

# ---------------------------------------------------------------------
# REQUIRED
#
# SEC fair-access policy requires a descriptive User-Agent that
# identifies you and gives SEC a way to contact you.
# Format: "Name Email"
# ---------------------------------------------------------------------
SEC_USER_AGENT=Your Name your.email@example.com
CACHE_BACKEND=database
# REDIS_URL=redis://127.0.0.1:6379/1
# ---------------------------------------------------------------------
# OPTIONAL - sane defaults are used when these are absent
# ---------------------------------------------------------------------

# Django secret key (recommended on servers). If unset and DJANGO_DEBUG
# is not True, a random key is generated once and saved to .secret_key.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=

# HTTP timeouts in seconds
# SEC_CONNECT_TIMEOUT=10
# SEC_READ_TIMEOUT=30

# Total attempts per SEC request (1 = no retry)
# SEC_MAX_RETRIES=4

# Minimum seconds between SEC requests (SEC allows ~10 req/sec)
# SEC_MIN_REQUEST_INTERVAL=0.15

# Maximum EDGAR full-text-search hits to page through
# SEC_SEARCH_MAX_RESULTS=200

# Where filings are written (defaults to backend/downloads)
# SEC_DOWNLOAD_DIR=

# ---------------------------------------------------------------------
# P-01: production security. ALL of these default to OFF so a laptop on
# http://localhost keeps working. Set them on the server.
#
# The acceptance test is that `python manage.py check --deploy` comes
# back clean before go-live.
# ---------------------------------------------------------------------

# The session cookie is https-only. Without this it travels in clear
# text. Leave UNSET on a laptop: a Secure cookie is never sent back over
# http://localhost, so every request 401s after login.
# AUTH_COOKIE_SECURE=True

# Lax is the only CSRF protection on cookie-authenticated requests.
# Do not set this to None without real CSRF enforcement first (P-05).
# AUTH_COOKIE_SAMESITE=Lax

# Redirect http -> https. Must stay off locally or the dev server
# bounces every request and nothing loads.
# SECURE_SSL_REDIRECT=True

# Tell browsers to use https only, for one year. Only switch this on
# once the host is fully on https: it locks browsers out of the plain
# http version for the duration.
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False

# Django's own session and CSRF cookies, https only.
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# Behind a reverse proxy (nginx, a load balancer) Django sees plain
# http on the internal hop, so SECURE_SSL_REDIRECT would loop forever.
# Set this ONLY when a proxy you control sets X-Forwarded-Proto.
# USE_X_FORWARDED_PROTO=True

# Hostnames this app will answer to. Django rejects anything else.
# DJANGO_ALLOWED_HOSTS=watcher.example.com
